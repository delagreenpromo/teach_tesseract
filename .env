# ============================================================
# API
# ============================================================
API_BASE_URL=http://127.0.0.1:8000
API_AUTH_ENDPOINT=/core/api/Auth/authenticate
API_GET_OBJECTS_ID=/core/api/objects/select
API_GET_BLOB_ID=/core/api/files/objects/{obj_id}
API_DOWNLOAD_ENDPOINT=/core/api/files/objects/{obj_id}/files/{blob_id}
API_SEND_CONTENT=/core/api/objects/{obj_id}/attributes
API_FIRST_ATTRIBUTE_ID=30357
API_LAST_ATTRIBUTE_ID=30356
API_USERNAME=your_username
API_PASSWORD=your_password
API_POLLING_INTERVAL=60

# ============================================================
# Paths
# ============================================================
RESULTS_DIR=./results
TOKEN_DB_PATH=results/unique_tokens.db

# ============================================================
# Processing
# ============================================================
IS_PRODUCTION=true
SAVE_IMAGES=false
DEBUG=true
MAX_FILES_PER_CYCLE=0
ALLOWED_FILE_TYPES=dwg.pdf,cdw.pdf
LOG_LEVEL=DEBUG # DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_FILE=logs.log
LOG_MODE=both  # console / file / both / none

# ============================================================
# OCR
# ============================================================
OCR_DPI=300
OCR_LANG=rus
OCR_PSM=6
OCR_USE_ADVANCED_RECOGNITION=true
OCR_MIN_AREA_RATIO=0.005
OCR_WIDTH_TOLERANCE=0.3
OCR_CHAR_WHITELIST=

OCR_AUTO_FORMAT=true
# ============================================================
# OCR: общие (fallback, если формат не определён)
# ============================================================
OCR_KERNEL_WIDTH=30
OCR_KERNEL_HEIGHT=90
OCR_DILATION_ITERATIONS=2

# ============================================================
# OCR: per-format (auto-detect by page size)
# ============================================================
# A4
OCR_KERNEL_A4_WIDTH=30
OCR_KERNEL_A4_HEIGHT=40
OCR_DILATION_A4=2

# A3
OCR_KERNEL_A3_WIDTH=30
OCR_KERNEL_A3_HEIGHT=60
OCR_DILATION_A3=2

# A2
OCR_KERNEL_A2_WIDTH=30
OCR_KERNEL_A2_HEIGHT=90
OCR_DILATION_A2=2

# A1
OCR_KERNEL_A1_WIDTH=40
OCR_KERNEL_A1_HEIGHT=120
OCR_DILATION_A1=2

# A0
OCR_KERNEL_A0_WIDTH=40
OCR_KERNEL_A0_HEIGHT=150
OCR_DILATION_A0=2

# ============================================================
# Selection / Exclusion keywords
# ============================================================
SELECTION_KEYWORDS=материал,гост,допуски,требования,пункт,размеры,технические требования,общие допуски,покрытие,маркировать,сварка,пункты
EXCLUDE_KEYWORDS=подписан,сертификат,эцп,укэп,унэп,владелец подписи,действительно,действителен,квалифицированной,электронной подписью

# ============================================================
# Admin panel
# ============================================================
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_PORT=5002
ADMIN_SECRET_KEY=teach-tesseract-admin-secret

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs.log

# ============================================================
# Docker / runtime
# ============================================================
UID=1000
GID=1000